# ─────────────────────────────────────────────────────────────
#  Kopiraj u .env.local i popuni. NIKAD ne commituj .env.local
# ─────────────────────────────────────────────────────────────

# ── Email (Resend) ───────────────────────────────────────────
# https://resend.com/api-keys
# Besplatno: 100 emaila/mesecno, ALI samo na adresu registrovanog
# vlasnika naloga. Za svakog klijenta treba zaseban domen.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Adresa sa koje se šalje. Za klijenta MORA biti na njegovom domenu,
# inače Resend odbija (SPF/DKIM provera).
ORDER_FROM_EMAIL=narudzbe@imedomena.rs

# ── Kome idu narudžbe i upiti ────────────────────────────────
# Za demo je tvoj Gmail; za klijenta — njegova adresa.
NEXT_PUBLIC_SHOP_EMAIL=porudzbine@imedomena.rs

# ── Google Sheets (panel za praćenje narudžbi) ──────────────
# Ako ove tri promenljive nisu popunjene, narudžbe se šalju samo
# na email i NE upisuju se u tabelu. Demo radi bez ovoga.
#
# 1. Google Cloud Console → novi projekat
# 2. Omogući "Google Sheets API"
# 3. Credentials → Service Account → novi ključ (JSON)
# 4. Iz JSON-a kopiraj:
#      client_email → GOOGLE_SERVICE_ACCOUNT_EMAIL
#      private_key   → GOOGLE_PRIVATE_KEY  (celi, sa \n na krajevima redova)
# 5. Napravi prazan Google Sheet i deli ga sa service account
#    email-om (Desni klik → Dijeli → dodaj e-mail)
# 6. Iz URL-a Sheet-a izvuči ID:
#    https://docs.google.com/spreadsheets/d/ID_OVDE/edit
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Ime taba u Sheet-u (opciono, podrazumevano "Narudzbe")
GOOGLE_SHEET_TAB=Narudzbe

# ── Analitika (opciono, obe besplatne) ────────────────────────
# Ako su prazne, sajt radi normalno — samo ne prikuplja statistiku.

# GA4: analytics.google.com → Administracija → Izvori podataka → Web
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Meta Pixel: business.facebook.com/events_manager → Data Sources → Web
NEXT_PUBLIC_META_PIXEL_ID=123456789012345